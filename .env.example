# Where the three forms (booking modal, contact form, book pre-order) are sent.
# Production: the Google Apps Script web-app URL (README → "Forms → Google Sheets"), e.g.
#   https://script.google.com/macros/s/xxxxxxxx/exec
# Leave empty for demo mode (no network request, success message shown).
NEXT_PUBLIC_FORM_ENDPOINT=

# Only needed for services that require a public access key in the body (e.g. Web3Forms).
NEXT_PUBLIC_FORM_ACCESS_KEY=

# Production URL (used for social-share metadata), e.g. https://donsergio.com.ua
NEXT_PUBLIC_SITE_URL=
